{
  "info": {
    "name": "CourierSync - Logistics API",
    "description": "Auth (REST) + Package (GraphQL). Login/Register guardan accessToken/refreshToken en variables de colección automáticamente. Para createPackage/updatePackage llena originPlaceId y destinationPlaceId con UUIDs válidos de la tabla place.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "adminEmail", "value": "test@gmail.com" },
    { "key": "customerEmail", "value": "customer@example.com" },
    { "key": "password", "value": "password123" },
    { "key": "originPlaceId", "value": "" },
    { "key": "destinationPlaceId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "packageUuid", "value": "" },
    { "key": "packageUuidPropose", "value": "" },
    { "key": "trackingCode", "value": "" },
    { "key": "placeUuid", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
                  "if (body && body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
