type User {
    id: ID!
    name: String!
    email: String!
}

type Role {
    id: ID!
    name: String!
    description: String
}

input UserInput {
    name: String!
    email: String!
    roleId: Int!
    temporaryPassword: String!
}

extend type Query {
    findAllUsers: [User!]!
    findUserById(id: ID!): User
    getCurrentUserData: User
}

extend type Mutation {
    createUser(input: UserInput!): User!
    deleteUser(id: ID!): Boolean!
}
