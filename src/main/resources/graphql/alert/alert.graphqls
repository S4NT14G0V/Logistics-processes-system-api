type AlertResponse {
    id: ID!
    description: String
    registeredAt: String
    alertType: AlertType
    packageId: ID
}

type AlertType {
    id: ID!
    name: String!
    description: String
}

extend type Query {
    findAllAlerts: [AlertResponse!]!
    findAllAlertsByUserId(userId: ID!): [AlertResponse!]!
}

extend type Mutation {
    sendAlertToUser(userId: ID!, packageId: ID!, alertTypeId: Int!, description: String): Boolean!
}
